# =====================================================================
# UNIFIED TELEGRAM MULTI-CHANNEL & MULTI-MT5 TERMINAL BOT CONFIGURATION
# =====================================================================

# =====================================================================
# 1. Telegram API Configuration
# =====================================================================
# Get your API ID and API Hash from https://my.telegram.org (under API Development tools)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890

# Session file name (saved locally in this project folder)
TELEGRAM_SESSION_NAME=trading_unified_session

# =====================================================================
# 2. Google Gemini AI Configuration
# =====================================================================
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Models:
# - gemini-3.8-flash (Latest, multimodal, high accuracy)
# - gemini-2.5-flash (Fast, balanced for text and vision)
# - gemini-1.5-flash (High speed standard)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=30

# =====================================================================
# 3. Dynamic Lot Size Configuration (Per $50 Base Account Balance)
# =====================================================================
# Automatically scales position sizes for each instrument per $50 in account balance:
#   GOLD                      : 0.02 lots per $50
#   BITCOIN (BTC)             : 0.03 lots per $50
#   US OIL (WTI/Crude)        : 0.02 lots per $50
#   US 30 (Dow Jones)         : 0.10 lots per $50
#   Currency Pairs (Forex)    : 0.10 lots per $50
#   Default (other symbols)   : 0.02 lots per $50
USE_DYNAMIC_LOT=true
BASE_ACCOUNT_SIZE=50.0

LOT_GOLD_PER_50=0.02
LOT_BTC_PER_50=0.03
LOT_USOIL_PER_50=0.02
LOT_US30_PER_50=0.10
LOT_FOREX_PER_50=0.10
LOT_DEFAULT_PER_50=0.02

# Scaling Mode:
# - "proportional" : continuous scaling (e.g. $75 balance -> 1.5x base lot)
# - "step"         : discrete $50 blocks (e.g. $50-$99 -> 1x, $100-$149 -> 2x)
LOT_SCALING_MODE=proportional

# Behavior when balance is below $50:
# - "min_base"     : maintains the base lot size (e.g. 0.02 for Gold) even if balance is $25-$49
# - "proportional" : scales down proportionally towards minimum lot size
LOT_BELOW_BASE_MODE=min_base

MIN_LOT_SIZE=0.01
MT5_DEFAULT_LOT=0.02

# =====================================================================
# 4. MetaTrader 5 Global Execution Settings
# =====================================================================
# Maximum allowed slippage deviation in points
MT5_DEVIATION=20

# Dry Run Safety Mode:
# When set to true, signals are fully parsed and simulated WITHOUT sending real orders.
# Set to false to execute real orders on your MT5 accounts.
DRY_RUN=false

FORCE_GOLD_ONLY=false
DEFAULT_GOLD_SYMBOL=GOLD.i#

# Vision / Ansh Order Execution Mode:
# - "auto"    : If marked entry is close to market price, enters Market Order; otherwise Pending Order.
# - "market"  : Always enters Market Order immediately at current market Ask/Bid.
# - "pending" : Strictly places Pending Limit/Stop orders at the exact key levels.
EXECUTION_MODE=auto
MAX_SLIPPAGE_POINTS=60
TARGET_TO_USE=TP1

# Real-Time Breakout Observer (watches live ticks for range breaks on both sides)
BREAKOUT_MONITOR_ENABLED=true
BREAKOUT_CHECK_INTERVAL_SEC=1.0
WATCHER_EXPIRY_HOURS=24

# Broker Symbol Mappings (JSON format)
SYMBOL_MAPPINGS={"USOIL": "OILCash#", "USOILCASH": "OILCash#", "USOILSPOT": "OILCash#", "WTI": "OILCash#", "CRUDE": "OILCash#", "OIL": "OILCash#", "UKOIL": "BRENTCash#", "BRENT": "BRENTCash#", "GOLD": "GOLD.i#", "XAUUSD": "GOLD.i#", "SILVER": "SILVER.i#", "XAGUSD": "SILVER.i#", "BTC": "BTCUSD#", "BTCUSD": "BTCUSD#", "BITCOIN": "BTCUSD#", "US 30": "US30Cash#", "US30": "US30Cash#", "NAS100": "US100Cash#", "US100": "US100Cash#", "SPX500": "US500Cash#", "GER40": "GER40Cash#", "EURUSD": "EURUSD#", "GBPUSD": "GBPUSD#", "USDJPY": "USDJPY#"}

# =====================================================================
# 5. Telegram Channel <-> MT5 Terminal Pairs Configuration
# =====================================================================
# You can define as many pairs as you want: PAIR_1_*, PAIR_2_*, PAIR_3_*, ...
#
# For each pair:
#   PAIR_<N>_NAME     : Descriptive name for logging (e.g. Ansh-Vision, TWM-Text)
#   PAIR_<N>_CHANNEL  : Telegram Channel ID (e.g. -1001234567890), @username, or Title
#   PAIR_<N>_MT5_PATH : Full path to terminal64.exe for this MT5 terminal instance
#   PAIR_<N>_MODE     : "image" (extracts TradingView chart images with Gemini Vision)
#                       "text"  (reads direct text messages with AI & Regex parser)
#                       "both"  (accepts both images and text signals)
#   PAIR_<N>_MAGIC    : Unique magic number to tag orders placed by this pair
#   PAIR_<N>_PAST_HOURS: Number of past hours of chat to retrieve on startup (e.g. 2, 4, 24).
#                        Set to a number > 0 to fetch and process past messages on startup.
#                        Leave blank or set to 0 to disable retrieving past messages.
#   PAIR_<N>_LOGIN    : (Optional) MT5 account login number if terminal requires it
#   PAIR_<N>_PASSWORD : (Optional) MT5 account password
#   PAIR_<N>_SERVER   : (Optional) Broker server name

# ---------------------------------------------------------------------
# PAIR 1: Ansh Channel (Image Chart Vision Analysis)
# ---------------------------------------------------------------------
PAIR_1_NAME=Ansh-Chart-Vision
PAIR_1_CHANNEL=-1001936359682
PAIR_1_MT5_PATH=C:\Users\Administrator\Desktop\MT5-Ansh-Tel-Bot\terminal64.exe
PAIR_1_MODE=image
PAIR_1_MAGIC=777999
PAIR_1_EXECUTION_MODE=auto
# Number of past hours of messages to retrieve on startup (0 or blank = disabled)
PAIR_1_PAST_HOURS=0

# ---------------------------------------------------------------------
# PAIR 2: TWM Channel (Direct Text Messages & Signals)
# ---------------------------------------------------------------------
PAIR_2_NAME=TWM-Text-Signals
PAIR_2_CHANNEL=-1003387639038
PAIR_2_MT5_PATH=C:\Users\Administrator\Desktop\MT5_TWM_Forex_Premium_Group\terminal64.exe
PAIR_2_MODE=text
PAIR_2_MAGIC=888123
# Number of past hours of messages to retrieve on startup (0 or blank = disabled)
PAIR_2_PAST_HOURS=0

